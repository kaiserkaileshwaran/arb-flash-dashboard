{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "includeFiles": "{index.html,dashboard/**,docs/**,reports/**,scripts/**}"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.py?__path=/" },
    { "source": "/index.html", "destination": "/api/index.py?__path=/index.html" },
    { "source": "/dashboard", "destination": "/api/index.py?__path=/dashboard" },
    { "source": "/dashboard/(.*)", "destination": "/api/index.py?__path=/dashboard/$1" },
    { "source": "/docs", "destination": "/api/index.py?__path=/docs" },
    { "source": "/docs/(.*)", "destination": "/api/index.py?__path=/docs/$1" },
    { "source": "/reports/(.*)", "destination": "/api/index.py?__path=/reports/$1" },
    { "source": "/api/(.*)", "destination": "/api/index.py?__path=/api/$1" }
  ]
}
